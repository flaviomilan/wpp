{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpp:events:1.0",
  "title": "wpp normalized WhatsApp event 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "message.created",
        "message.edited",
        "message.deleted",
        "message.enriched",
        "message.transcribed",
        "reaction.added",
        "reaction.updated",
        "reaction.removed",
        "reaction.snapshot"
      ]
    },
    "source": {
      "const": "whatsapp"
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "live",
            "history",
            "recovered",
            "migration",
          "processing",
          "correction"
          ]
        },
        "derived": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "origin",
        "derived",
        "limitations"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "event_type",
    "source",
    "account_id",
    "group_id",
    "message_id",
    "occurred_at",
    "observed_at",
    "provenance",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "actor": {
      "type": "object",
      "properties": {
        "participant_id": {
          "type": "string"
        },
        "native_id": {
          "type": "string"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "participant_id",
        "native_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "native_key": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "sender_id": {
          "type": "string"
        },
        "from_me": {
          "type": "boolean"
        }
      },
      "required": [
        "message_id",
        "sender_id",
        "from_me"
      ],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "attachment_id": {
          "type": "string"
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]+$"
        },
        "file_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "enum": [
            "not_retained",
            "available",
            "unavailable"
          ]
        }
      },
      "required": [
        "attachment_id",
        "file_name",
        "mime_type",
        "size_bytes",
        "sha256",
        "file_reference",
        "availability"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "sender_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_me": {
          "type": "boolean"
        },
        "message_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "text",
            "audio",
            "image",
            "video",
            "document",
            "other",
            null
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcription_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcription_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "content_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_status": {
          "enum": [
            "available",
            "unavailable",
            "deleted",
            "ambiguous"
          ]
        }
      },
      "required": [
        "message_id",
        "sender_id",
        "from_me",
        "message_type",
        "text",
        "caption",
        "transcription_text",
        "transcription_version",
        "content_version",
        "source_id",
        "content_status"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "native_key": {
          "$ref": "#/$defs/native_key"
        },
        "sender": {
          "type": "object",
          "properties": {
            "participant_id": {
              "type": "string"
            },
            "native_id": {
              "type": "string"
            },
            "aliases": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "participant_id",
            "native_id",
            "aliases",
            "display_name"
          ],
          "additionalProperties": false
        },
        "group": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "group_id",
            "display_name"
          ],
          "additionalProperties": false
        },
        "sent_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "message_type": {
          "enum": [
            "text",
            "audio",
            "image",
            "video",
            "document",
            "other"
          ]
        },
        "original_type": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "reply": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "sender_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "quoted_text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "message_id",
            "sender_id",
            "quoted_text"
          ],
          "additionalProperties": false
        },
        "mentions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "forwarded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "forwarding_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "attachments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/attachment"
          }
        },
        "reactions_availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "edited": {
          "type": "boolean"
        },
        "deleted": {
          "type": "boolean"
        },
        "content_status": {
          "enum": [
            "available",
            "unavailable",
            "deleted"
          ]
        }
      },
      "required": [
        "source_id",
        "content_version",
        "native_key",
        "sender",
        "group",
        "sent_at",
        "message_type",
        "original_type",
        "text",
        "caption",
        "reply",
        "mentions",
        "forwarded",
        "forwarding_score",
        "attachments",
        "reactions_availability",
        "edited",
        "deleted",
        "content_status"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "native_key": {
          "$ref": "#/$defs/native_key"
        },
        "transcription_version": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "attachment_id": {
          "type": "string"
        },
        "file_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_retained": {
          "const": false
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "start_ms",
              "end_ms",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source_id",
        "native_key",
        "transcription_version",
        "text",
        "language",
        "model",
        "model_sha256",
        "engine",
        "processed_at",
        "attachment_id",
        "file_reference",
        "original_retained",
        "segments"
      ],
      "additionalProperties": false
    },
    "reaction": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_state_known": {
          "type": "boolean"
        },
        "reaction_message_id": {
          "type": "string"
        },
        "target_message": {
          "$ref": "#/$defs/target"
        }
      },
      "required": [
        "actor",
        "emoji",
        "previous_emoji",
        "previous_state_known",
        "reaction_message_id",
        "target_message"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "reactions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "actor": {
                "$ref": "#/$defs/actor"
              },
              "emoji": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "occurred_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "reaction_message_id": {
                "type": "string"
              }
            },
            "required": [
              "actor",
              "emoji",
              "occurred_at",
              "reaction_message_id"
            ],
            "additionalProperties": false
          }
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "target_message": {
          "$ref": "#/$defs/target"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_state_known": {
          "type": "boolean"
        },
        "reaction_message_id": {
          "type": "string"
        }
      },
      "required": [
        "reactions",
        "availability",
        "completeness",
        "target_message"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "message.created",
              "message.edited",
              "message.deleted",
              "message.enriched"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/message"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "message.transcribed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/transcript"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "reaction.added",
              "reaction.updated",
              "reaction.removed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reaction"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "reaction.snapshot"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    }
  ]
}
